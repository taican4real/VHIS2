# VHIS Website — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Secrets must NOT use NEXT_PUBLIC_ prefix.

# Required
DATABASE_URL="postgresql://vhis:password@localhost:5432/vhis_dev"
PAYLOAD_SECRET="replace-with-a-strong-random-secret"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Optional — media (Cloudflare R2 via Payload adapter)
CLOUDFLARE_R2_BUCKET="vhis-media-dev"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""

# Optional — transactional email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="enquiries@vhis.example"

# Optional — analytics (privacy-consent gated)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""